{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "adbqr",
  "identifier": "io.github.adityawibisana.adbqr",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "adbqr",
        "width": 940,
        "height": 680,
        "minWidth": 700,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["assets/icon.png", "assets/icon.ico"]
  }
}
