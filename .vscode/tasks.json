{
  "version": "2.0.0",
  "tasks": [
    {
      // "process" runs cargo.exe directly, bypassing the default terminal
      // shell (which may be WSL, where the Windows toolchain is not available).
      "label": "cargo build (debug)",
      "type": "process",
      "command": "${env:USERPROFILE}\\.cargo\\bin\\cargo.exe",
      "args": ["build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo build (release)",
      "type": "process",
      "command": "${env:USERPROFILE}\\.cargo\\bin\\cargo.exe",
      "args": ["build", "--release"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$rustc"]
    }
  ]
}
